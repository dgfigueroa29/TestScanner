<?xml version="1.0" encoding="utf-8"?>
<!--
    Capa monocroma para los iconos temáticos de Android 13+.

    Cuando el usuario activa "icono temático", el sistema descarta fondo y primer plano y pinta
    **esta** capa con los colores de su fondo de pantalla. Sin declararla, Scanly sería de las
    aplicaciones que se quedan con su icono a todo color en una pantalla en la que el resto se ha
    teñido, que es justo lo que delata una app que no se revisó para la versión actual.

    El color es negro por convención: el sistema lo sustituye, así que solo importa la silueta.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M30,45 L30,30 L45,30 M63,30 L78,30 L78,45 M78,63 L78,78 L63,78 M45,78 L30,78 L30,63"
        android:strokeColor="#000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M40.5,54 L67.5,54"
        android:strokeColor="#000000"
        android:strokeWidth="7.2"
        android:strokeLineCap="round" />
</vector>
