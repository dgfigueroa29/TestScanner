<?xml version="1.0" encoding="utf-8"?>
<!--
  App-level strings: the product name and the navigation destinations. Each screen's own text lives
  in its feature module.

  `values/` has no qualifier, so it is the fallback for every locale that has no catalogue of its
  own. That is why it is English: a phone set to German gets English here, not Spanish.
-->
<resources>
    <!-- The brand name is deliberately not translated: it is the same word in every store listing. -->
    <string name="app_name">Scanly</string>
    <string name="app_tagline">Scan anything. Nothing leaves your phone.</string>

    <string name="destination_scanner">Scan</string>
    <string name="destination_comparison">Compare</string>
    <string name="destination_history">History</string>
    <string name="destination_settings">Settings</string>
</resources>
