<?xml version="1.0" encoding="utf-8"?>
<!--
  Scanner and comparison screen strings.

  This is `values/` with no qualifier, so it is the **fallback for every locale**: a phone set to
  German, Japanese or Portuguese lands here. That is why the default catalogue is English and the
  Spanish one lives in `values-es/`, and not the other way round — with Spanish as the default, a
  German user would have got Spanish.

  Compose resources are per module: each feature owns its own catalogue and there is no global file
  growing without an owner. The ones carrying `%1$s` receive data produced by the domain — an engine
  id, a format, a latency; only the text around them is translated.
-->
<resources>
    <!-- Session state -->
    <string name="session_starting">Starting…</string>
    <string name="session_scanning">Scanning with %1$s</string>
    <!-- Basic mode: which engine is reading is workbench information, and the id is internal. -->
    <string name="session_scanning_simple">Scanning…</string>
    <string name="session_switched_from">Fell back from %1$s: the previous engine could not continue.</string>
    <string name="session_error">Error: %1$s</string>

    <!-- Controls -->
    <string name="action_stop">Stop</string>
    <string name="action_auto">Auto</string>
    <string name="action_dismiss">Dismiss</string>
    <string name="action_scan_from_image">From image</string>
    <string name="action_grant_camera">Grant camera access</string>
    <string name="action_submit">Submit</string>
    <string name="continuous_scan">Continuous scanning</string>
    <string name="torch_on">Torch on</string>
    <string name="torch_off">Torch</string>
    <string name="zoom_ratio">Zoom %1$dx</string>
    <string name="manual_input_label">Code</string>

    <!-- Catalogue -->
    <string name="engines_title">Scanning engines</string>
    <string name="detections_title">Results</string>
    <string name="detection_meta">%1$s · %2$s</string>
    <string name="detection_latency"> · %1$d ms</string>
    <string name="engine_selected">Selected</string>
    <string name="engine_select">Select</string>
    <string name="engine_in_use">In use</string>
    <string name="engine_formats_count">%1$d formats</string>
    <string name="engine_supports_continuous"> · continuous</string>
    <string name="engine_supports_multiple"> · multiple</string>
    <string name="engine_supports_torch"> · torch</string>
    <string name="engine_no_permissions"> · no permissions</string>

    <!-- Availability -->
    <string name="availability_available">Available</string>
    <string name="availability_requires_permission">Requires %1$s permission</string>
    <string name="availability_requires_download">Needs to download its model</string>
    <string name="availability_planned">Planned for phase %1$d</string>
    <string name="availability_failed">Could not be checked</string>

    <!-- Format filter -->
    <string name="formats_title">Formats (%1$d of %2$d)</string>
    <string name="formats_hint">Dropping formats speeds up detection and avoids cross reads. Clear them all and they all come back: a request with no formats is not valid.</string>

    <!-- Result actions (RF-13) -->
    <string name="result_copy">Copy</string>
    <!-- What gets copied from a Wi-Fi QR: handing someone `WIFI:T:WPA;S:…;;` is no use to them. -->
    <string name="share_wifi">Network: %1$s</string>
    <string name="share_wifi_with_password">Network: %1$s · Password: %2$s</string>
    <string name="share_separator"> · </string>
    <string name="result_share">Share</string>
    <string name="result_open_link">Open link</string>
    <string name="result_open_email">Write email</string>
    <string name="result_open_phone">Call</string>
    <string name="result_open_sms">Send SMS</string>
    <string name="result_open_map">Open in maps</string>

    <!-- One-off messages -->
    <string name="message_engine_switched">Switched to another engine because the previous one could not continue</string>
    <string name="message_camera_permission_denied">Without camera access only the engines that do not use it remain available</string>
    <string name="message_manual_input_unavailable">Manual entry is not available</string>
    <string name="message_copied">Copied</string>
    <string name="message_copy_failed">Could not copy to the clipboard</string>
    <string name="message_share_failed">Could not open the share sheet</string>
    <string name="message_open_failed">No app can open this</string>
    <string name="message_no_code_in_image">No code found in that image</string>

    <!-- Engine comparison (G5) -->
    <string name="comparison_title">Compare engines</string>
    <string name="comparison_start">Compare</string>
    <string name="comparison_reset">Reset</string>
    <string name="comparison_hint">Point at the same code with the comparison running: every engine reads it on its own and the scoreboard shows which one gets there first.</string>
    <string name="comparison_needs_two_engines">Comparing needs at least two available engines. Right now there are %1$d.</string>
    <string name="comparison_participants">Taking part: %1$s</string>
    <string name="comparison_leader">%1$s · best</string>
    <string name="comparison_counts">%1$d distinct codes · %2$d reads</string>
    <string name="comparison_latencies">first: %1$s · average: %2$s</string>
    <string name="comparison_frames">%1$d frames</string>
    <string name="comparison_frames_per_detection"> · %1$d per read</string>
    <string name="comparison_failures"> · %1$d failures</string>
    <string name="comparison_no_data">—</string>
    <string name="comparison_millis">%1$d ms</string>

    <!-- Accessibility (RNF-05). The action buttons repeat their label on every result: without
         these descriptions, a screen reader announces "Copy" five times without saying what. -->
    <string name="a11y_viewfinder">Camera viewfinder</string>
    <string name="a11y_no_detections">No code in the viewfinder</string>
    <string name="a11y_detections_in_view">%1$d codes in the viewfinder</string>
    <string name="a11y_copy_value">Copy %1$s</string>
    <string name="a11y_share_value">Share %1$s</string>
    <string name="a11y_open_value">Open %1$s</string>
    <string name="a11y_zoom">Camera zoom</string>

    <!-- Camera-first layout: the states that take over the viewfinder -->
    <string name="permission_title">Camera access</string>
    <string name="permission_body">Scanly needs the camera to read codes. Frames are processed on the device and never leave it — the app has no internet permission at all.</string>
    <string name="no_camera_title">No live camera here</string>
    <string name="no_camera_body">This device has no capture Scanly can drive. You can still scan a picture or type a code by hand.</string>
    <string name="session_paused">Paused</string>
    <string name="action_resume">Resume</string>

    <!-- Results sheet -->
    <string name="results_hint_title">Point at a code</string>
    <string name="results_hint_body">QR, EAN, Code 128 and 14 more formats. It reads on its own — there is nothing to press.</string>
    <string name="results_more">%1$d more</string>
    <string name="results_show_less">Show less</string>
    <string name="results_clear">Clear</string>
    <string name="a11y_results_expand">Show every result</string>
    <string name="a11y_results_collapse">Show only the latest result</string>
</resources>
