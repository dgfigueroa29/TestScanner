<?xml version="1.0" encoding="utf-8"?>
<!--
  Textos de la pantalla de escaneo y de la de comparación (deuda D5).

  Los recursos de Compose son por módulo: cada feature tiene los suyos y no hay un fichero global
  que crezca sin dueño. Los que llevan `%1$s` reciben datos que produce el dominio — el id de un
  motor, un formato, una latencia—; el texto que los rodea es lo único que se traduce.
-->
<resources>
    <!-- Estado de la sesión -->
    <string name="session_idle">Sesión detenida</string>
    <string name="session_starting">Arrancando…</string>
    <string name="session_scanning">Escaneando con %1$s</string>
    <string name="session_finished">Sesión terminada</string>
    <string name="session_switched_from">Se degradó desde %1$s: el motor anterior no pudo continuar.</string>
    <string name="session_error">Error: %1$s</string>

    <!-- Controles -->
    <string name="action_scan">Escanear</string>
    <string name="action_stop">Detener</string>
    <string name="action_auto">Auto</string>
    <string name="action_dismiss">Descartar</string>
    <string name="action_scan_from_image">Desde imagen</string>
    <string name="action_grant_camera">Conceder permiso de cámara</string>
    <string name="action_submit">Enviar</string>
    <string name="continuous_scan">Escaneo continuo</string>
    <string name="torch_on">Linterna encendida</string>
    <string name="torch_off">Linterna</string>
    <string name="zoom_ratio">Zoom %1$dx</string>
    <string name="manual_input_label">Código</string>

    <!-- Catálogo -->
    <string name="engines_title">Alternativas de escaneo</string>
