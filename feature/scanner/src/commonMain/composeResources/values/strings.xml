    <string name="a11y_viewfinder">Visor de la cámara</string>
    <string name="a11y_no_detections">Ningún código en el visor</string>
    <string name="a11y_detections_in_view">%1$d códigos en el visor</string>
    <string name="a11y_copy_value">Copiar %1$s</string>
