    <string name="formats_hint">Quitar formatos acelera la detección y evita lecturas cruzadas. Si los quitás todos vuelven todos: una petición sin formatos no es válida.</string>

    <!-- Acciones sobre el resultado (RF-13) -->
    <string name="result_copy">Copiar</string>
